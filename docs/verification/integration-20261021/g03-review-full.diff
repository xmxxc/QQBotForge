+        assert await asyncio.to_thread(entered.wait, 2)
+        asyncio.get_running_loop().call_later(0.01, release.set)
+        assert await host.modules.disable('group_state', _persist=False)
+    finally:
+        release.set()
+        response = await pending
+    assert released_before_timeout == [True]
+    assert response.status == 503
+    assert (await host.api()).status == 404
+
+
+@pytest.mark.parametrize('cancellations', [1, 2])
+async def test_cancelled_refresh_finishes_its_write_before_new_facts_are_saved(group_host, monkeypatch, cancellations):
+    host = group_host
+    entered, release = threading.Event(), threading.Event()
+    original = host.state.store._run
+
+    def pause_before_database_lock(sql, params, read):
+        # Fix thread scheduling at the SQLite boundary while retaining real writes.
+        if sql.startswith('INSERT') and json.loads(params[3])['groups']['group-a']['reliable']:
+            entered.set()
+            if not release.wait(2):
+                raise RuntimeError('fake storage scheduling timeout')
+        return original(sql, params, read)
+
+    monkeypatch.setattr(host.state.store, '_run', pause_before_database_lock)
+    pending = asyncio.create_task(host.state.refresh('bot-a', 'group-a'))
+    observation = None
+    try:
+        assert await asyncio.to_thread(entered.wait, 2)
+        for _ in range(cancellations):
+            pending.cancel()
+            await asyncio.sleep(0)
+        observation = asyncio.create_task(host.event('普通消息', user='member-a', group='group-b'))
+        during = (await (await host.api()).json())['data']
+        assert not during['groups'][0]['reliable']
+        assert not pending.done()  # Cancellation must drain the underlying write.
+    finally:
+        release.set()
+        with pytest.raises(asyncio.CancelledError):
+            await pending
+        if observation:
+            await observation
+    assert await host.modules.reload('group_state')
+    restored = (await (await host.api()).json())['data']
+    assert [group['group'] for group in restored['groups']] == ['group-a', 'group-b']
+    assert all(not group['reliable'] for group in restored['groups'])
diff --git a/tests/bot_modules/test_group_state_audit.py b/tests/bot_modules/test_group_state_audit.py
new file mode 100644
index 0000000..3d6a38c
--- /dev/null
+++ b/tests/bot_modules/test_group_state_audit.py
@@ -0,0 +1,147 @@
+"""Persistence failure boundaries through public group-state operations and real SQLite."""
+
+import asyncio
+import sqlite3
+
+import pytest
+from test_group_roster import roster_platform
+
+
+async def wait_until(predicate):
+    async def poll():
+        while not predicate():
+            await asyncio.sleep(0.001)
+    await asyncio.wait_for(poll(), 3)
+
+
+async def complete_roster(host):
+    roster_platform(host)
+    assert (await host.state.snapshot('bot-b'))['groups'] == []
+    assert (await (await host.api('POST', 'roster', body={'group': 'group-a'})).json())['data']['complete']
+    return await host.state.members('bot-a', 'group-a', limit=1)
+
+
+async def assert_retired(host, earlier):
+    group = next(g for g in (await host.state.snapshot('bot-a'))['groups'] if g['group'] == 'group-a')
+    assert not group['roster']['complete']
+    assert not group['members']['member-a']['reliable']
+    assert group['members']['member-a']['member_role'] == 'member'
+    assert group['version'] > earlier['version']
+    with pytest.raises(ValueError):
+        await host.state.members('bot-a', 'group-a', cursor=earlier['next_cursor'], version=earlier['version'], generation=earlier['generation'])
+    return group
+
+
+async def test_failed_confirmation_retires_old_proof_until_new_roster(group_host):
+    host = group_host
+    earlier = await complete_roster(host)
+    path = host.modules.get_context('group_state').get_data_path('group-state.db')
+    with sqlite3.connect(path) as db:
+        db.execute("CREATE TRIGGER fail_confirmation BEFORE INSERT ON extension_records BEGIN SELECT RAISE(ABORT, 'fake disk failure'); END")
+    try:
+        response = await host.api('POST', 'confirm-member', body={'group': 'group-a', 'member': 'member-a', 'evidence': '主人核对角色变化', 'member_role': 'owner'})
+        assert response.status == 503
+        group = await assert_retired(host, earlier)
+        assert group['members']['member-a']['reason'] == 'persistence_failed'
+    finally:
+        with sqlite3.connect(path) as db:
+            db.execute('DROP TRIGGER fail_confirmation')
+    retry = await host.api('POST', 'confirm-member', body={'group': 'group-a', 'member': 'member-a', 'evidence': '主人重新核对', 'member_role': 'owner'})
+    result = (await retry.json())['data']
+    assert result['reliable'] and result['member_role'] == 'owner'
+    assert not (await host.state.snapshot('bot-a'))['groups'][0]['roster']['complete']
+    assert (await host.state.snapshot('bot-b'))['groups'] == []
+    assert (await host.state.sync_roster('bot-a', 'group-a'))['complete']
+
+
+@pytest.mark.parametrize('cancelled', [False, True])
+async def test_confirmation_wait_and_cancel_never_publish_old_proof(group_host, cancelled):
+    host = group_host
+    earlier = await complete_roster(host)
+    blocker = sqlite3.connect(host.modules.get_context('group_state').get_data_path('group-state.db'))
+    blocker.execute('BEGIN IMMEDIATE')
+    operation = asyncio.create_task(host.state.confirm_member('bot-a', 'group-a', 'member-a', evidence='主人核对角色', member_role='owner'))
+    try:
+        await wait_until(lambda: host.state.pending_writes.get('bot-a'))
+        await assert_retired(host, earlier)
+        if cancelled:
+            operation.cancel()
+            await asyncio.sleep(0.01)
+            assert not operation.done()  # SQLite's real worker still owns the write order.
+    finally:
+        blocker.commit()
+        blocker.close()
+        if cancelled:
+            with pytest.raises(asyncio.CancelledError):
+                await operation
+        else:
+            assert (await operation)['reliable']
+    if cancelled:
+        group = await assert_retired(host, earlier)
+        assert group['members']['member-a']['status'] == 'historical'
+        assert group['members']['member-a']['reason'] == 'confirmation_cancelled'
+        assert await host.modules.reload('group_state')
+        restored = (await host.state.snapshot('bot-a'))['groups'][0]
+        assert not restored['roster']['complete'] and not restored['members']['member-a']['reliable']
+
+
+@pytest.mark.parametrize('operation', ['refresh', 'roster', 'member'])
+async def test_cancelling_initial_queued_write_ends_current_operation(group_host, operation):
+    host = group_host
+    earlier = await complete_roster(host)
+    blocker = sqlite3.connect(host.modules.get_context('group_state').get_data_path('group-state.db'))
+    blocker.execute('BEGIN IMMEDIATE')
+    first = asyncio.create_task(host.state.refresh('bot-a', 'group-blocker'))
+    second = None
+    try:
+        await wait_until(lambda: host.state.pending_writes.get('bot-a'))
+        method = {'refresh': host.state.refresh, 'roster': host.state.sync_roster, 'member': host.state.verify_member}[operation]
+        args = ('bot-a', 'group-a', 'member-a') if operation == 'member' else ('bot-a', 'group-a')
+        second = asyncio.create_task(method(*args))
+        await wait_until(lambda: host.state.pending_writes.get('bot-a', 0) >= 2)
+        second.cancel()
+        with pytest.raises(asyncio.CancelledError):
+            await second
+    finally:
+        blocker.commit()
+        blocker.close()
+        await first
+        if second is not None and not second.done():
+            second.cancel()
+            await asyncio.gather(second, return_exceptions=True)
+    group = next(g for g in (await host.state.snapshot('bot-a'))['groups'] if g['group'] == 'group-a')
+    assert not group['roster']['complete'] and group['version'] > earlier['version']
+    if operation == 'refresh':
+        assert group['status'] == 'historical' and group['reason'] == 'refresh_cancelled'
+    elif operation == 'roster':
+        assert group['roster']['reason'] == 'roster_cancelled'
+        assert group['members']['member-a']['reason'] == 'roster_cancelled'
+    else:
+        record = group['members']['member-a']
+        assert record['status'] == 'historical' and record['reason'] == 'verification_cancelled'
+    assert (await host.state.snapshot('bot-b'))['groups'] == []
+
+
+
+async def test_cancelled_confirmation_preserves_newer_same_group_observation(group_host):
+    host = group_host
+    earlier = await complete_roster(host)
+    blocker = sqlite3.connect(host.modules.get_context('group_state').get_data_path('group-state.db'))
+    blocker.execute('BEGIN IMMEDIATE')
+    operation = asyncio.create_task(host.state.confirm_member('bot-a', 'group-a', 'member-a', evidence='主人核对角色', member_role='owner'))
+    observation = None
+    try:
+        await wait_until(lambda: host.state.pending_writes.get('bot-a'))
+        observation = asyncio.create_task(host.event('新的群消息', user='member-new', group='group-a'))
+        await wait_until(lambda: host.state.pending_writes.get('bot-a', 0) >= 2)
+        operation.cancel()
+    finally:
+        blocker.commit()
+        blocker.close()
+        with pytest.raises(asyncio.CancelledError):
+            await operation
+        if observation is not None:
+            await observation
+    group = await assert_retired(host, earlier)
+    assert group['source'] == 'native_event' and group['reason'] == 'observed_event_requires_refresh'
+    assert group['members']['member-new']['reason'] == 'requires_verification'
diff --git a/tests/bot_modules/test_group_state_page.cjs b/tests/bot_modules/test_group_state_page.cjs
new file mode 100644
index 0000000..ce82ac4
--- /dev/null
+++ b/tests/bot_modules/test_group_state_page.cjs
@@ -0,0 +1,184 @@
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const test = require('node:test');
+const vm = require('node:vm');
+const {setImmediate: tick} = require('node:timers/promises');
+
+// Run the shipped page script, replacing only the DOM and network boundaries.
+async function page() {
+    const html = fs.readFileSync(path.join(__dirname, '../../modules/group_state/page.html'), 'utf8');
+    const nodes = {};
+    for (const [, id] of html.matchAll(/id="([^"]+)"/g)) {
+        nodes[id] = {
+            value: id === 'gs-group' ? 'group-a' : '', textContent: '', disabled: false, options: [],
+            append(option) {
+                this.options.push(option);
+                if (!this.value) this.value = option.value;
+            },
+        };
+    }
+    const requests = [];
+    vm.runInNewContext(html.match(/<script>([\s\S]*?)<\/script>/)[1], {
+        document: {getElementById: id => nodes[id], createElement: () => ({})}, URLSearchParams,
+        fetch: (url, options) => url === '/api/bots'
+            ? Promise.resolve({json: async () => ({data: {bots: [{appid: 'bot-a'}, {appid: 'bot-b'}]}})})
+            : new Promise((resolve, reject) => requests.push({url, options, resolve, reject})),
+    });
+    await tick();
+    return {
+        nodes, requests,
+        output: () => nodes['gs-output'].textContent,
+        async reply(request, data) {
+            request.resolve({ok: true, json: async () => ({success: true, data})});
+            await tick();
+        },
+    };
+}
+
+test('an earlier GET cannot restore verified facts after a failed refresh', async () => {
+    const host = await page();
+    const earlier = host.requests[0];
+    host.nodes['gs-refresh'].onclick();
+    const latest = {group: 'group-a', version: 4, reliable: false, status: 'historical', reason: 'permission_denied'};
+    await host.reply(host.requests.at(-1), latest);
+    assert.deepEqual(JSON.parse(host.output()), latest);
+    await host.reply(earlier, {bot: 'bot-a', version: 3, groups: [{group: 'group-a', reliable: true}]});
+    assert.deepEqual(JSON.parse(host.output()), latest);
+});
+
+test('changing Bot clears old facts and loads only the selected Bot', async () => {
+    const host = await page();
+    await host.reply(host.requests[0], {bot: 'bot-a', groups: [{reliable: true}]});
+    host.nodes['gs-load'].onclick();
+    const earlier = host.requests.at(-1);
+    host.nodes['gs-bot'].value = 'bot-b';
+    host.nodes['gs-bot'].onchange?.();
+    assert.equal(host.output(), '');
+    const selected = host.requests.at(-1);
+    assert.match(selected.url, /bot=bot-b$/);
+    await host.reply(earlier, {bot: 'bot-a', groups: [{reliable: true}]});
+    assert.equal(host.output(), '');
+    const latest = {bot: 'bot-b', groups: []};
+    await host.reply(selected, latest);
+    assert.deepEqual(JSON.parse(host.output()), latest);
+});
+
+test('returning to a Bot cannot revive a request from the earlier selection', async () => {
+    const host = await page();
+    const earlierA = host.requests[0];
+    host.nodes['gs-bot'].value = 'bot-b';
+    host.nodes['gs-bot'].onchange();
+    const earlierB = host.requests.at(-1);
+    host.nodes['gs-bot'].value = 'bot-a';
+    host.nodes['gs-bot'].onchange();
+    const latest = {bot: 'bot-a', version: 8, groups: [{reliable: false}]};
+    await host.reply(host.requests.at(-1), latest);
+    await host.reply(earlierA, {bot: 'bot-a', version: 3, groups: [{reliable: true}]});
+    await host.reply(earlierB, {bot: 'bot-b', groups: []});
+    assert.deepEqual(JSON.parse(host.output()), latest);
+});
+
+for (const failure of ['network', 'http', 'json']) {
+    test(`a late ${failure} error cannot clear a newer successful result`, async () => {
+        const host = await page();
+        const earlier = host.requests[0];
+        host.nodes['gs-load'].onclick();
+        const latest = {bot: 'bot-a', version: 8, groups: []};
+        await host.reply(host.requests.at(-1), latest);
+        const status = host.nodes['gs-status'].textContent;
+        if (failure === 'network') earlier.reject(new Error('old network failure'));
+        else earlier.resolve({
+            ok: false,
+            json: async () => {
+                if (failure === 'json') throw new Error('old invalid JSON');
+                return {success: false, error: 'old HTTP error'};
+            },
+        });
+        await tick();
+        assert.deepEqual(JSON.parse(host.output()), latest);
+        assert.equal(host.nodes['gs-status'].textContent, status);
+    });
+}
+
+test('starting a request clears old verified facts and current errors remain visible', async () => {
+    const host = await page();
+    await host.reply(host.requests[0], {bot: 'bot-a', groups: [{reliable: true}]});
+    host.nodes['gs-refresh'].onclick();
+    assert.equal(host.output(), '');
+    assert.equal(host.nodes['gs-status'].textContent, '正在读取…');
+    host.requests.at(-1).reject(new Error('current network failure'));
+    await tick();
+    assert.equal(host.output(), '');
+    assert.equal(host.nodes['gs-status'].textContent, 'current network failure');
+});
+
+test('a late complete roster cannot overwrite a newer failed member verification', async () => {
+    const host = await page();
+    host.nodes['gs-roster'].onclick();
+    const earlier = host.requests.at(-1);
+    host.nodes['gs-verify'].onclick();
+    const latest = {group: 'group-a', reliable: false, state: 'unknown', reason: 'permission_denied'};
+    await host.reply(host.requests.at(-1), latest);
+    await host.reply(earlier, {group: 'group-a', complete: true, version: 3});
+    assert.deepEqual(JSON.parse(host.output()), latest);
+});
+
+test('a late member page from an earlier Bot cannot enable the next page', async () => {
+    const host = await page();
+    host.nodes['gs-members'].onclick();
+    const earlier = host.requests.at(-1);
+    host.nodes['gs-bot'].value = 'bot-b';
+    host.nodes['gs-bot'].onchange();
+    await host.reply(host.requests.at(-1), {bot: 'bot-b', groups: []});
+    await host.reply(earlier, {group: 'group-a', version: 2, generation: 'g', members: [{member: 'old'}], next_cursor: '1.key'});
+    assert.equal(host.nodes['gs-next'].disabled, true);
+    assert.deepEqual(JSON.parse(host.output()), {bot: 'bot-b', groups: []});
+});
+
+test('editing the group retires the earlier member page and its late response', async () => {
+    const host = await page();
+    host.nodes['gs-members'].onclick();
+    await host.reply(host.requests.at(-1), {group: 'group-a', version: 2, generation: 'g', members: [], next_cursor: '1.key'});
+    assert.equal(host.nodes['gs-next'].disabled, false);
+    host.nodes['gs-members'].onclick();
+    const earlier = host.requests.at(-1);
+    host.nodes['gs-group'].value = 'group-b';
+    host.nodes['gs-group'].oninput();
+    assert.equal(host.nodes['gs-next'].disabled, true);
+    await host.reply(earlier, {group: 'group-a', version: 2, generation: 'g', members: [], next_cursor: '1.key'});
+    assert.equal(host.nodes['gs-next'].disabled, true);
+    assert.equal(host.output(), '');
+});
+
+test('the next page carries the cursor, version and generation of the current group page', async () => {
+    const host = await page();
+    host.nodes['gs-members'].onclick();
+    await host.reply(host.requests.at(-1), {group: 'group-a', version: 2, generation: 'g', members: [], next_cursor: '1.key'});
+    host.nodes['gs-next'].onclick();
+    const query = new URL(host.requests.at(-1).url, 'http://host').searchParams;
+    assert.deepEqual(Object.fromEntries(query), {bot: 'bot-a', group: 'group-a', limit: '30', generation: 'g', version: '2', cursor: '1.key'});
+});
+
+test('editing a group clears already displayed results immediately', async () => {
+    const host = await page();
+    host.nodes['gs-members'].onclick();
+    await host.reply(host.requests.at(-1), {group: 'group-a', members: [{member: 'old'}], next_cursor: '1.key'});
+    host.nodes['gs-group'].value = 'group-b';
+    host.nodes['gs-group'].oninput();
+    assert.equal(host.output(), '');
+    assert.equal(host.nodes['gs-next'].disabled, true);
+});
+
+test('returning to a group cannot restore a request from its earlier selection', async () => {
+    const host = await page();
+    host.nodes['gs-members'].onclick();
+    const earlier = host.requests.at(-1);
+    host.nodes['gs-group'].value = 'group-b';
+    host.nodes['gs-group'].oninput();
+    host.nodes['gs-group'].value = 'group-a';
+    host.nodes['gs-group'].oninput();
+    await host.reply(earlier, {group: 'group-a', members: [{member: 'old'}], next_cursor: '1.key'});
+    assert.equal(host.output(), '');
+    assert.equal(host.nodes['gs-next'].disabled, true);
+});
